# ---- Required --------------------------------------------------------------
DOMAIN=sianexis.example.com
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=sianexis.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://sianexis.example.com
DB_NAME=sianexis
DB_USER=sianexis
DB_PASSWORD=change-me
DB_HOST=db

# ---- First run only (creates sample structure + admin account) -------------
RUN_SEED=1
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=change-me-now
DJANGO_SUPERUSER_EMAIL=you@example.com

# ---- Email (contact requests, confirmations) --------------------------------
CONTACT_EMAIL=info@sianexis.example.com
DEFAULT_FROM_EMAIL=no-reply@sianexis.example.com
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# ---- Optional: spam protection ---------------------------------------------
# CAPTCHA_PROVIDER=hcaptcha        # hcaptcha | recaptcha | turnstile
# CAPTCHA_SITE_KEY=
# CAPTCHA_SECRET_KEY=

# ---- Optional: CRM -----------------------------------------------------------
# CRM_WEBHOOK_URL=https://hooks.zapier.com/...   # Zapier / Make / n8n / Odoo / Zoho Flow
# CRM_WEBHOOK_SECRET=                              # signs the payload (X-SiaNexis-Signature, HMAC-SHA256)
# HUBSPOT_TOKEN=                                   # HubSpot private-app token

# ---- Optional: performance ---------------------------------------------------
# REDIS_URL=redis://redis:6379/1                   # shared cache / rate limits across workers
# STATIC_URL_OVERRIDE=https://cdn.example.com/static/
# MEDIA_URL_OVERRIDE=https://cdn.example.com/media/
# WEB_CONCURRENCY=3
# API_THROTTLE=120/min

# ---- Backups -----------------------------------------------------------------
BACKUP_KEEP_DAYS=14
BACKUP_HOUR_UTC=03
