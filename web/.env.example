# Copy to .env.production and fill in. These values are public (they end up in the web page), keep real secrets out of git.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Cloudinary (free plan, no card): cloud name + an UNSIGNED upload preset. Can also be set later from Admin > Site settings.
VITE_CLOUDINARY_CLOUD=
VITE_CLOUDINARY_PRESET=
# Public address of the site (used for sitemap.xml / canonical links)
VITE_SITE_URL=
